msgid "Content preview"
msgstr "Inhaltsvorschau"

#. Translators: Search-dialog button that selects the highlighted result
#. in the main window and closes the dialog. "&" marks the mnemonic.
#: ui/search_dialog.py:56
msgid "&Show snippet"
msgstr "&Textbaustein anzeigen"

#. Translators: Search-dialog button that closes the dialog without
#. selecting a result. "&" marks the keyboard mnemonic.
#. Translators: Settings-dialog button that discards pending changes and
#. closes the dialog. "&" marks the keyboard mnemonic.
#. Translators: Snippet-editor button that discards unsaved changes and
#: ui/search_dialog.py:60 ui/settings_dialog.py:85 ui/snippet_editor.py:109
msgid "&Cancel"
msgstr "&Abbrechen"

#. Translators: Title of an error while searching snippets.
#: ui/search_dialog.py:168
msgid "Search error"
msgstr "Suchfehler"

#. Translators: Window title for application settings.
#: ui/settings_dialog.py:43
msgid "Settings"
msgstr "Einstellungen"

#. Translators: Tab for general application settings such as language.
#. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:74
msgid "&General"
msgstr "All&gemein"

#. Translators: Tab for configuring the global keyboard shortcut.
#. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:78
msgid "&Keyboard"
msgstr "&Tastatur"

#. Translators: Settings-dialog button that saves pending changes and
#. closes the dialog. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:82
msgid "&OK"
msgstr "&OK"

#. Translators: Settings-dialog button that saves and activates pending
#. changes without closing the dialog. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:88
msgid "&Apply"
msgstr "Ü&bernehmen"

#. Translators: Label for the user-interface language selector.
#. "&" marks the keyboard mnemonic for the adjacent choice control.
#: ui/settings_dialog.py:119
msgid "&Language"
msgstr "&Sprache"

#. Translators: Explains that a newly selected interface language is
#. loaded the next time the application starts.
#: ui/settings_dialog.py:141
msgid "Language changes take effect after restarting btText."
msgstr "Sprachänderungen werden nach einem Neustart von btText wirksam."

#. Translators: General setting that controls whether text copied from
#. a snippet is added to the Windows clipboard history. "&" marks the
#. keyboard mnemonic.
#: ui/settings_dialog.py:151
msgid "Include copied snippet &text in the Windows clipboard history"
msgstr "Kopierten Textbaustein im Windows-&Zwischenablageverlauf speichern"

#. Translators: General setting that controls whether copied snippet
#. text may be synchronized through the Windows cloud clipboard.
#. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:167
msgid "Allow copied snippet text to be stored in the Windows &cloud"
msgstr "Kopierte Textbausteine in der Windows-&Cloud speichern"

#. Translators: General setting that enables automatic expansion of
#. snippet hotstrings. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:181
msgid "&Enable hotstrings"
msgstr "Hotstrings &aktivieren"

#. Translators: Settings-page explanation of the global shortcut and
#. its required modifier keys.
#: ui/settings_dialog.py:270
msgid "Configure the global shortcut used to show or hide the main window. A shortcut must contain Ctrl, Shift, Alt or the Windows key."
msgstr "Legen Sie die globale Tastenkombination zum Ein- oder Ausblenden des Hauptfensters fest. Sie muss Strg, Umschalt, Alt oder die Windows-Taste enthalten."

#. Translators: Label for the currently configured global shortcut.
#. "&" marks the keyboard mnemonic for the adjacent read-only field.
#: ui/settings_dialog.py:279
msgid "Current &hotkey"
msgstr "Aktuelle Tasten&kombination"

#. Translators: Accessible name for the read-only field displaying
#. the currently configured global show-or-hide shortcut.
#: ui/settings_dialog.py:287
msgid "Current show or hide window shortcut"
msgstr "Aktuelle Tastenkombination zum Ein- oder Ausblenden des Hauptfensters"

#. Translators: Button that starts listening for a new global
#. shortcut. "&" marks the keyboard mnemonic.
#. Translators: Button label restored after shortcut recording ends; it
#. starts listening for another shortcut. "&" marks the mnemonic.
#: ui/settings_dialog.py:294 ui/settings_dialog.py:390
msgid "&Record new shortcut"
msgstr "&Neue Tastenkombination aufzeichnen"

#. Translators: Button that stops the current shortcut recording
#. without accepting it. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:301
msgid "Cancel &recording"
msgstr "Auf&zeichnung abbrechen"

#. Translators: Button that selects btText's default global shortcut as
#. the pending setting. "&" marks the keyboard mnemonic.
#: ui/settings_dialog.py:310
msgid "Use &default"
msgstr "Stan&dard verwenden"

#. Translators: Initial status before shortcut recording starts.
#: ui/settings_dialog.py:317
msgid "Recording is not active."
msgstr "Die Aufzeichnung ist nicht aktiv."

#. Translators: Accessible name for the text that reports shortcut
#. recording instructions and results.
#: ui/settings_dialog.py:321
msgid "Shortcut recording status"
msgstr "Status der Tastenkombinationsaufzeichnung"

#. Translators: Temporary button label while btText waits for the user to
#. press a new global shortcut.
#: ui/settings_dialog.py:356
msgid "Press shortcut now"
msgstr "Tastenkombination jetzt drücken"

#. Translators: Accessible name while btText is waiting for a shortcut;
#. Escape cancels and Tab leaves the recording control.
#: ui/settings_dialog.py:361
msgid "Recording shortcut. Press Escape to cancel or Tab to leave recording."
msgstr "Tastenkombination wird aufgezeichnet. Drücken Sie Esc zum Abbrechen oder die Tabulatortaste, um die Aufzeichnung zu verlassen."

#. Translators: Instructions shown while recording a new global
#. shortcut. Keep Escape, Tab, and Shift+Tab recognizable key names.
#: ui/settings_dialog.py:370
msgid "Press one shortcut now. Escape cancels; Tab and Shift+Tab remain available."
msgstr "Drücken Sie jetzt eine Tastenkombination. Esc bricht ab; Tab und Umschalt+Tab bleiben verfügbar."

#. Translators: Status after the user cancels shortcut recording.
#: ui/settings_dialog.py:382
msgid "Shortcut recording cancelled."
msgstr "Aufzeichnung der Tastenkombination abgebrochen."

#. Translators: Accessible button name restored after recording ends; the
#. button starts recording another global shortcut.
#: ui/settings_dialog.py:393
msgid "Record new shortcut"
msgstr "Neue Tastenkombination aufzeichnen"

#. Translators: Status announced after an invalid shortcut ends
#. recording. {error} explains why the key was rejected.
#: ui/settings_dialog.py:440
#, python-brace-format
msgid "Shortcut not accepted: {error}. Recording has stopped."
msgstr "Tastenkombination nicht akzeptiert: {error}. Die Aufzeichnung wurde beendet."

#. Translators: Status after recording succeeds. The shortcut is not
#. active until Apply or OK saves it. {shortcut} is such as Ctrl+Alt+T.
#: ui/settings_dialog.py:452
#, python-brace-format
msgid "Shortcut {shortcut} recorded. Choose Apply or OK to activate it."
msgstr "Tastenkombination {shortcut} aufgezeichnet. Wählen Sie „Übernehmen“ oder „OK“, um sie zu aktivieren."

#. Translators: Status after selecting btText's default shortcut; it
#. is only activated when Apply or OK saves the setting.
#: ui/settings_dialog.py:586
msgid "Default shortcut selected. Choose Apply or OK to activate it."
msgstr "Standardtastenkombination ausgewählt. Wählen Sie „Übernehmen“ oder „OK“, um sie zu aktivieren."

#. Translators: Status confirming that all pending application settings
#. were saved and activated where possible.
#: ui/settings_dialog.py:624
msgid "The settings have been applied."
msgstr "Die Einstellungen wurden übernommen."

#. Translators: Window title for creating a snippet.
#: ui/snippet_editor.py:24
msgid "Add snippet"
msgstr "Textbaustein hinzufügen"

#. Translators: Window title for changing an existing snippet.
#: ui/snippet_editor.py:27
msgid "Edit snippet"
msgstr "Textbaustein bearbeiten"

#. Translators: Label for the editable snippet name. "&" marks the
#. keyboard mnemonic for the adjacent text field.
#: ui/snippet_editor.py:39
msgid "&Name"
msgstr "&Name"

#. Translators: Label for the category in which the snippet is stored.
#. "&" marks the mnemonic for the adjacent category selector.
#: ui/snippet_editor.py:43
msgid "&Category"
msgstr "&Kategorie"

#. Translators: Group label for the snippet's ranking in search
#. results. "&" marks the keyboard mnemonic.
#: ui/snippet_editor.py:69
msgid "&Weight"
msgstr "&Gewichtung"

#. Translators: Label for the optional abbreviation that expands after
#. the user types a boundary key. "&" marks the keyboard mnemonic.
#: ui/snippet_editor.py:77
msgid "&Hotstring"
msgstr "&Hotstring"

#. Translators: Hint explaining when an optional hotstring expands.
#: ui/snippet_editor.py:81
msgid "Optional; expands after Space, Enter, Tab, or punctuation"
msgstr "Optional; wird nach Leertaste, Eingabetaste, Tab oder Satzzeichen erweitert"

#. Translators: Label for the snippet text that will be inserted.
#. "&" marks the mnemonic for the adjacent multiline editor.
#: ui/snippet_editor.py:85
msgid "C&ontent"
msgstr "&Inhalt"

#. Translators: Snippet-editor button that saves the snippet and closes
#. the dialog. "&" marks the keyboard mnemonic.
#: ui/snippet_editor.py:105
msgid "&Save"
msgstr "&Speichern"

#. Translators: Title of a dialog reporting invalid form input.
#: ui/snippet_editor.py:178 ui/validators.py:28
msgid "Validation error"
msgstr "Validierungsfehler"

#. Translators: Accessible name for a hidden numeric sort column that
#. corresponds to the visible snippet weight.
#: ui/snippet_list.py:49
msgid "Weight number"
msgstr "Gewichtungswert"

#. Translators: Snippet-list menu command that opens the editor to create
#. a snippet in the selected category. Keep Ctrl+N after "\t".
#: ui/snippet_list.py:127
msgid "New snippet\tCtrl+N"
msgstr "Neuer Textbaustein\tCtrl+N"

#. Translators: Snippet-list menu command that pastes a copied or
#. cut category into the current category. Keep Ctrl+V after "\t".
#: ui/snippet_list.py:134
msgid "Paste into category\tCtrl+V"
msgstr "In Kategorie einfügen\tCtrl+V"

#. Translators: Snippet-list menu command that inserts the
#. selected snippet into the previously active application.
#. Keep Enter after "\t".
#: ui/snippet_list.py:146
msgid "Insert snippet\tEnter"
msgstr "Textbaustein einfügen\tEnter"

#. Translators: Snippet-list menu command that copies the
#. selected snippet's text to the Windows clipboard. Keep
#. Ctrl+Shift+C after "\t".
#: ui/snippet_list.py:154
msgid "Copy text to clipboard\tCtrl+Shift+C"
msgstr "Text in die Zwischenablage kopieren\tCtrl+Shift+C"

#. Translators: Snippet-list menu command that opens the
#. selected snippet in the editor. Keep F2 after "\t".
#: ui/snippet_list.py:161
msgid "Edit snippet\tF2"
msgstr "Textbaustein bearbeiten\tF2"

#. Translators: Snippet-list menu command that copies the selected
#. snippet or snippets. Keep Ctrl+C after "\t".
#: ui/snippet_list.py:171
msgid "Copy snippet\tCtrl+C"
msgid_plural "Copy snippets\tCtrl+C"
msgstr[0] "Textbaustein kopieren\tCtrl+C"
msgstr[1] "Textbausteine kopieren\tCtrl+C"

#. Translators: Snippet-list menu command that cuts the selected
#. snippet or snippets. Keep Ctrl+X after "\t".
#: ui/snippet_list.py:181
msgid "Cut snippet\tCtrl+X"
msgid_plural "Cut snippets\tCtrl+X"
msgstr[0] "Textbaustein ausschneiden\tCtrl+X"
msgstr[1] "Textbausteine ausschneiden\tCtrl+X"

#. Translators: Snippet-list menu command that deletes the selected
#. snippet or snippets. The final "Delete" is the keyboard key.
#: ui/snippet_list.py:201
msgid "Delete snippet\tDelete"
msgid_plural "Delete snippets\tDelete"
msgstr[0] "Textbaustein löschen\tEntf"
msgstr[1] "Textbausteine löschen\tEntf"

#. Translators: Title of an error copying snippet text to the
#. Windows clipboard.
#: ui/snippet_list.py:259
msgid "Clipboard error"
msgstr "Zwischenablagefehler"

#. Translators: Status after a snippet's text was copied to the Windows
#. clipboard.
#: ui/snippet_list.py:266
msgid "Text copied to clipboard."
msgstr "Text in die Zwischenablage kopiert."

#. Translators: Status after copying snippets; they are not pasted yet.
#. {count} is the number copied, and Ctrl+V is the paste shortcut.
#: ui/snippet_list.py:279
#, python-brace-format
msgid "Copied {count} snippet. Select a category and press Ctrl+V."
msgid_plural "Copied {count} snippets. Select a category and press Ctrl+V."
msgstr[0] "{count} Textbaustein kopiert. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."
msgstr[1] "{count} Textbausteine kopiert. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."

#. Translators: Status after cutting snippets; they are not moved yet.
#. {count} is the number cut, and Ctrl+V is the paste shortcut.
#: ui/snippet_list.py:287
#, python-brace-format
msgid "Cut {count} snippet. Select a category and press Ctrl+V."
msgid_plural "Cut {count} snippets. Select a category and press Ctrl+V."
msgstr[0] "{count} Textbaustein ausgeschnitten. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."
msgstr[1] "{count} Textbausteine ausgeschnitten. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."

#. Translators: Explains that the top-level paste command only
#. accepts a copied or cut category, not snippets.
#: ui/snippet_list.py:308
msgid "Only a category can be pasted as a top-level category."
msgstr "Nur eine Kategorie kann auf der obersten Ebene eingefügt werden."

#. Translators: Title of information about pasting a category
#. at the category-tree root.
#: ui/snippet_list.py:311
msgid "Paste as top-level"
msgstr "Auf oberster Ebene einfügen"

#. Translators: Status after a pending copy or cut operation is pasted.
#. {count} includes all transferred categories and snippets.
#: ui/snippet_list.py:363
#, python-brace-format
msgid "Transferred {count} item."
msgid_plural "Transferred {count} items."
msgstr[0] "{count} Element übertragen."
msgstr[1] "{count} Elemente übertragen."

#. Translators: Confirmation before permanently deleting one snippet.
#. {name} is the snippet's name.
#: ui/snippet_list.py:454
#, python-brace-format
msgid "Do you want to delete the snippet '{name}'?"
msgstr "Möchten Sie den Textbaustein „{name}“ löschen?"

#. Translators: Title of the confirmation for deleting one snippet.
#: ui/snippet_list.py:457
msgid "Delete snippet?"
msgstr "Textbaustein löschen?"

#. Translators: Confirmation before permanently deleting several
#. selected snippets. {count} is the number selected.
#: ui/snippet_list.py:462
#, python-brace-format
msgid "Do you want to delete {count} selected snippet?"
msgid_plural "Do you want to delete {count} selected snippets?"
msgstr[0] "Möchten Sie {count} ausgewählten Textbaustein löschen?"
msgstr[1] "Möchten Sie {count} ausgewählte Textbausteine löschen?"

#. Translators: Title of the confirmation for deleting multiple snippets.
#: ui/snippet_list.py:467
msgid "Delete snippets?"
msgstr "Textbausteine löschen?"

# | msgid "Delete snippet?"
#. Translators: Status after selected snippets were permanently deleted.
#. {count} is the number deleted.
#: ui/snippet_list.py:503
#, python-brace-format
msgid "Deleted {count} snippet."
msgid_plural "Deleted {count} snippets."
msgstr[0] "{count} Textbaustein gelöscht."
msgstr[1] "{count} Textbausteine gelöscht."

