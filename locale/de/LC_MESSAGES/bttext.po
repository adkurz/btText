msgstr "{value} im standardmäßigen lokalisierten Kurzformat."

#. Translators: Description for a localized date/time
#. variable. {value} is its value type; {format} is a
#. language-independent technical format name.
#: ui/variable_dialog.py:90
#, python-brace-format
msgid "{value} using the localized '{format}' format."
msgstr "{value} im lokalisierten Format '{format}'."

#. Translators: Description for a language-independent date/time
#. variable. {value} is a localized value description.
#: ui/variable_dialog.py:102
#, python-brace-format
msgid "{value} using the language-independent ISO format."
msgstr "{value} im sprachunabhängigen ISO-Format."

#. Translators: Window title for choosing a snippet variable.
#: ui/variable_dialog.py:122
