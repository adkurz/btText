#. Translators: Abbreviated Control-key name in a displayed shortcut,
#. for example "Ctrl+Alt+T".
#: app_settings.py:191
msgctxt "hotkey modifier"
msgid "Ctrl"
msgstr "Strg"

#. Translators: Shift-key name in a displayed keyboard shortcut.
#: app_settings.py:194
msgctxt "hotkey modifier"
msgid "Shift"
msgstr "Umschalt"

#. Translators: Alt-key name in a displayed keyboard shortcut.
#: app_settings.py:197
msgctxt "hotkey modifier"
msgid "Alt"
msgstr "Alt"

#. Translators: Abbreviated Windows-key name in a displayed shortcut.
#: app_settings.py:200
msgctxt "hotkey modifier"
msgid "Win"
msgstr "Win"

#. Translators: Title of a fatal startup error concerning the
#. snippet database.
#: btText.py:49
msgid "Database error"
msgstr "Datenbankfehler"

#. Translators: Title of a startup warning concerning settings.
#. Translators: Title of an error saving or applying settings.
#: btText.py:58 ui/main_frame.py:441
msgid "Settings error"
msgstr "Einstellungsfehler"

#. Translators: Title of a startup warning after a translation
#. catalog could not be loaded.
#: btText.py:67
msgid "Language error"
msgstr "Sprachfehler"

#. Translators: Startup error when the snippet database cannot be opened.
#. {reason} is a technical SQLite or operating-system message.
#: error_messages.py:23
#, python-brace-format
msgid "The database could not be opened: {reason}"
msgstr "Die Datenbank konnte nicht geöffnet werden: {reason}"

#. Translators: Startup error for a damaged or incomplete snippet database.
#. {missing_tables} is a comma-separated list of technical table names.
#: error_messages.py:32
#, python-brace-format
msgid "The database schema is incomplete. Missing table(s): {missing_tables}."
msgstr "Das Datenbankschema ist unvollständig. Fehlende Tabelle(n): {missing_tables}."

#. Translators: Startup error when the database comes from a newer btText and
#. cannot be safely read. Both placeholders are integer schema versions.
#: error_messages.py:41
#, python-brace-format
msgid "The database was created by a newer version of btText and cannot be opened. Database schema version: {database_version}; supported version: {supported_version}."
msgstr "Die Datenbank wurde mit einer neueren Version von btText erstellt und kann nicht geöffnet werden. Schemaversion der Datenbank: {database_version}; unterstützte Version: {supported_version}."

#. Translators: Startup error when btText cannot upgrade an older database.
#. {database_version} is its integer schema version.
#: error_messages.py:51
#, python-brace-format
msgid "No database migration is available from schema version {database_version}."
msgstr "Für die Schemaversion {database_version} ist keine Datenbankmigration verfügbar."

#. Translators: Startup error when a database upgrade did not reach its target
#. version. The migration name is technical; both versions are integers.
#: error_messages.py:60
#, python-brace-format
msgid "Database migration {migration_name} did not advance the schema from version {old_version} to version {new_version}."
msgstr "Die Datenbankmigration {migration_name} hat das Schema nicht von Version {old_version} auf Version {new_version} aktualisiert."

#. Translators: Error after a category disappeared before an operation could
#. finish. {id} is its internal integer database ID.
#: error_messages.py:68
#, python-brace-format
msgid "The category with ID {id} no longer exists."
msgstr "Die Kategorie mit der ID {id} ist nicht mehr vorhanden."

#. Translators: Error after a snippet disappeared before an operation could
#. finish. {id} is its internal integer database ID.
#: error_messages.py:74
#, python-brace-format
msgid "The snippet with ID {id} no longer exists."
msgstr "Der Textbaustein mit der ID {id} ist nicht mehr vorhanden."

#. Translators: Startup error when btText cannot load its settings file.
#. {reason} is a localized validation or operating-system error.
#: error_messages.py:80
#, python-brace-format
msgid "The settings file could not be read: {reason}"
msgstr "Die Einstellungsdatei konnte nicht gelesen werden: {reason}"

#. Translators: Error when btText cannot persist changed settings.
#. {reason} is a localized validation or operating-system error.
#: error_messages.py:88
#, python-brace-format
msgid "The settings file could not be saved: {reason}"
msgstr "Die Einstellungsdatei konnte nicht gespeichert werden: {reason}"

#. Translators: Fatal startup error when SQLite cannot enforce relationships
#. between categories and snippets.
#: error_messages.py:98
msgid "SQLite foreign-key support could not be enabled."
msgstr "Die Fremdschlüsselunterstützung von SQLite konnte nicht aktiviert werden."

#. Translators: Fatal startup error when stored records refer to missing
#. categories or otherwise violate a database foreign-key relationship.
#: error_messages.py:103
msgid "The database contains records with invalid relationships."
msgstr "Die Datenbank enthält Datensätze mit ungültigen Beziehungen."

#. Translators: Fatal startup error when category parent relationships form
#. a loop instead of a valid tree.
#: error_messages.py:108
msgid "The database contains a cycle in the category hierarchy."
msgstr "Die Datenbank enthält einen Zyklus in der Kategoriehierarchie."

#. Translators: Fatal startup error describing category records without names.
#: error_messages.py:116
msgid "The database contains categories without a name."
msgstr "Die Datenbank enthält Kategorien ohne Namen."

#. Translators: Fatal migration error for category names that are empty or
#. consist only of spaces.
#: error_messages.py:121
msgid "The database contains categories with an empty name."
msgstr "Die Datenbank enthält Kategorien mit einem leeren Namen."

#. Translators: Fatal migration error when a category refers to itself as
#. its parent.
#: error_messages.py:126
msgid "The database contains a category that is its own parent."
msgstr "Die Datenbank enthält eine Kategorie, die sich selbst als übergeordnete Kategorie verwendet."

#. Translators: Fatal migration error for snippet names that are empty or
#. consist only of spaces.
#: error_messages.py:131
msgid "The database contains snippets with an empty name."
msgstr "Die Datenbank enthält Textbausteine mit einem leeren Namen."

#. Translators: Fatal migration error for snippets whose reusable text is
#. empty.
#: error_messages.py:136
msgid "The database contains snippets with empty content."
msgstr "Die Datenbank enthält Textbausteine mit leerem Inhalt."

#. Translators: Fatal startup error for snippet records whose numeric
#. search-ranking weight is outside the supported range.
#: error_messages.py:141
msgid "The database contains snippets with an invalid weight."
msgstr "Die Datenbank enthält Textbausteine mit einer ungültigen Gewichtung."

#. Translators: Fatal startup error for duplicate snippet names in one
#. category.
#: error_messages.py:145
msgid "The database contains duplicate snippet names in a category."
msgstr "Die Datenbank enthält doppelte Textbausteinnamen innerhalb einer Kategorie."

#. Translators: Fatal migration error when two snippets in one category have
#. names that differ only in uppercase or lowercase letters.
#: error_messages.py:150
msgid "The database contains snippet names that differ only in letter case within the same category."
msgstr "Die Datenbank enthält Textbausteinnamen, die sich innerhalb derselben Kategorie nur durch Groß- und Kleinschreibung unterscheiden."

#. Translators: Fatal startup error for snippets without an existing category.
#: error_messages.py:155
msgid "The database contains snippets without a category."
msgstr "Die Datenbank enthält Textbausteine ohne Kategorie."

#. Translators: Validation error when a sibling category already uses this
#. name.
#: error_messages.py:161
msgid "A category with this name already exists at this level."
msgstr "Auf dieser Ebene ist bereits eine Kategorie mit diesem Namen vorhanden."

#. Translators: Internal error for an unsaved category without a database ID.
#: error_messages.py:165
msgid "The category has no ID."
msgstr "Die Kategorie hat keine ID."

#. Translators: Error when the intended parent category was deleted meanwhile.
#: error_messages.py:169
msgid "The parent category no longer exists."
msgstr "Die übergeordnete Kategorie ist nicht mehr vorhanden."

#. Translators: Validation error preventing a category being its own parent.
#: error_messages.py:173
msgid "A category cannot be its own parent."
msgstr "Eine Kategorie kann nicht ihre eigene übergeordnete Kategorie sein."

#. Translators: Validation error preventing a move into the category's subtree.
#: error_messages.py:177
msgid "A category cannot be moved below one of its descendants."
msgstr "Eine Kategorie kann nicht unter eine ihrer Unterkategorien verschoben werden."

#. Translators: Validation error preventing recursive copying into the same
#. category subtree.
#: error_messages.py:182
msgid "A category cannot be copied into itself or one of its descendants."
msgstr "Eine Kategorie kann nicht in sich selbst oder eine ihrer Unterkategorien kopiert werden."

#. Translators: Validation error for an empty category or snippet name.
#: error_messages.py:186
msgid "The name must not be empty."
msgstr "Der Name darf nicht leer sein."

#. Translators: Validation error when a snippet has no insertion text.
#: error_messages.py:190
msgid "The content must not be empty."
msgstr "Der Inhalt darf nicht leer sein."

#. Translators: Error when the snippet's selected category was deleted
#. meanwhile.
#: error_messages.py:194
msgid "The selected category no longer exists."
msgstr "Die ausgewählte Kategorie ist nicht mehr vorhanden."

#. Translators: Validation error when a snippet name is already used in the
#. same category.
#: error_messages.py:199
msgid "A snippet with this name already exists in this category."
msgstr "In dieser Kategorie ist bereits ein Textbaustein mit diesem Namen vorhanden."

#. Translators: Validation error for a snippet search-ranking weight outside
#. the allowed choices.
#: error_messages.py:204
msgid "The selected weight is not allowed."
msgstr "Die ausgewählte Gewichtung ist nicht zulässig."

#. Translators: Validation error when a hotstring contains a space, tab, or
#. another whitespace character.
#: error_messages.py:209
msgid "The hotstring must not contain whitespace."
msgstr "Der Hotstring darf keine Leerraumzeichen enthalten."

#. Translators: Validation error when another snippet already uses the same
#. global hotstring.
#: error_messages.py:214
msgid "This hotstring is already assigned to another snippet."
msgstr "Dieser Hotstring ist bereits einem anderen Textbaustein zugeordnet."

#. Translators: Internal error for an unsaved snippet without a database ID.
#: error_messages.py:218
msgid "The snippet has no ID."
msgstr "Der Textbaustein hat keine ID."

#. Translators: Validation error when a global shortcut contains an
#. unsupported keyboard key.
#: error_messages.py:223
msgid "The shortcut contains an unsupported key."
msgstr "Die Tastenkombination enthält eine nicht unterstützte Taste."

#. Translators: Validation error when a global shortcut has no Ctrl, Shift,
#. Alt, or Windows modifier.
#: error_messages.py:228
msgid "The shortcut requires at least one modifier."
msgstr "Die Tastenkombination muss mindestens eine Sondertaste enthalten."

#. Translators: Validation error when a shortcut from settings cannot be
#. parsed.
#: error_messages.py:232
msgid "The shortcut has an invalid format."
msgstr "Die Tastenkombination hat ein ungültiges Format."

#. Translators: Validation error when a shortcut repeats the same modifier.
#: error_messages.py:236
msgid "The shortcut contains a duplicate modifier."
msgstr "Die Tastenkombination enthält eine Sondertaste mehrfach."

#. Translators: Validation error when a shortcut has zero or multiple main
#. keys.
#: error_messages.py:240
msgid "The shortcut must contain exactly one key."
msgstr "Die Tastenkombination muss genau eine Haupttaste enthalten."

#. Translators: Validation error when a key cannot be used for a global
#. shortcut.
#: error_messages.py:244
msgid "This key cannot be used as a shortcut."
msgstr "Diese Taste kann nicht für eine Tastenkombination verwendet werden."

#. Translators: Settings error when the selected UI language has no installed
#. gettext catalog.
#: error_messages.py:249
msgid "No translation catalog is available for the selected language."
msgstr "Für die ausgewählte Sprache ist kein Übersetzungskatalog verfügbar."

#. Translators: Startup warning after a damaged translation catalog forced
#. btText to continue in English. {language} is a locale code such as de;
#. {reason} is a technical catalog-loading error.
#: error_messages.py:255
#, python-brace-format
msgid ""
"The translation catalog for {language} could not be loaded. btText will continue in English.\n"
"\n"
"{reason}"
msgstr ""
"Der Übersetzungskatalog für {language} konnte nicht geladen werden. btText wird auf Englisch fortgesetzt.\n"
"\n"
"{reason}"

#. Translators: Settings error when the saved UI language code is malformed.
#: error_messages.py:263
msgid "The language setting has an invalid format."
msgstr "Die Spracheinstellung hat ein ungültiges Format."

#. Translators: Safe fallback when no specific localized application-error
#. message is available.
#: error_messages.py:278
msgid "An unexpected application error occurred."
msgstr "Es ist ein unerwarteter Anwendungsfehler aufgetreten."

#. Translators: Language-choice entry that follows the operating
#. system's language when a matching catalog is installed.
#: i18n.py:67
msgid "System default"
msgstr "Systemstandard"

#. Translators: Root label of the main window's category tree.
#. Translators: Accessible name for the main window's category tree.
#: ui/category_tree.py:67 ui/main_frame.py:121
msgid "Categories"
msgstr "Kategorien"

#. Translators: Category-tree label. {name} is the category name and
#. {count} is the number of snippets directly in it, excluding children.
#: ui/category_tree.py:88
#, python-brace-format
msgid "{name} ({count})"
msgstr "{name} ({count})"

#. Translators: Category-tree placeholder shown when no category
#. has been created yet.
#: ui/category_tree.py:112
msgid "No categories"
msgstr "Keine Kategorien"

#. Translators: Category-tree menu command that creates a category at
#. the root level. Keep Ctrl+N after "\t".
#: ui/category_tree.py:170
msgid "New top-level category\tCtrl+N"
msgstr "Neue Hauptkategorie\tCtrl+N"

#. Translators: Category-tree menu command that creates a child of
#. the selected category. Keep Ctrl+Shift+N after "\t".
#: ui/category_tree.py:179
msgid "New subcategory\tCtrl+Shift+N"
msgstr "Neue Unterkategorie\tCtrl+Shift+N"

#. Translators: Category-tree menu command that pastes a copied or cut
#. category at the root level. Keep Ctrl+Shift+V after "\t".
#: ui/category_tree.py:190
msgid "Paste as top-level\tCtrl+Shift+V"
msgstr "Auf oberster Ebene einfügen\tCtrl+Shift+V"

#. Translators: Category-tree menu command that copies the selected
#. category and its contents. Keep Ctrl+C after "\t".
#: ui/category_tree.py:198
msgid "Copy\tCtrl+C"
msgstr "Kopieren\tCtrl+C"

#. Translators: Category-tree menu command that cuts the selected
#. category and its contents. Keep Ctrl+X after "\t".
#: ui/category_tree.py:201
msgid "Cut\tCtrl+X"
msgstr "Ausschneiden\tCtrl+X"

#. Translators: Category-tree menu command that pastes a copied or cut
#. category into the selected category. Keep Ctrl+V after "\t".
#: ui/category_tree.py:204
msgid "Paste into\tCtrl+V"
msgstr "Hier einfügen\tCtrl+V"

#. Translators: Category-tree menu command that renames the selected
#. category. Keep F2 after "\t".
#: ui/category_tree.py:216
msgid "Rename\tF2"
msgstr "Umbenennen\tF2"

#. Translators: Category-tree menu command that deletes the selected
#. category. The second "Delete" after "\t" is the keyboard key.
#: ui/category_tree.py:219
msgid "Delete\tDelete"
msgstr "Löschen\tEntf"

#. Translators: Prompt asking for the name of a category being created.
#: ui/category_tree.py:247
msgid "Enter the name of the new category"
msgstr "Geben Sie den Namen der neuen Kategorie ein."

#. Translators: Title of the dialog for creating a category.
#: ui/category_tree.py:249
msgid "Add category"
msgstr "Kategorie hinzufügen"

#. Translators: Prompt for a new child category. {parent_name} is its parent.
#: ui/category_tree.py:258
#, python-brace-format
msgid "Enter the name of the new subcategory of '{parent_name}'"
msgstr "Geben Sie den Namen der neuen Unterkategorie von „{parent_name}“ ein."

#. Translators: Title of the dialog for creating a child category.
#: ui/category_tree.py:262
msgid "Add subcategory"
msgstr "Neue Unterkategorie anlegen"

#. Translators: Prompt asking for a replacement category name.
#: ui/category_tree.py:295
msgid "Enter the new name of the category"
msgstr "Geben Sie den neuen Namen der Kategorie ein."

#. Translators: Title of the dialog for renaming a category.
#: ui/category_tree.py:297
msgid "Rename category"
msgstr "Kategorie umbenennen"

#. Translators: Rename prompt for a child category. {parent_name} is its
#. parent.
#: ui/category_tree.py:306
#, python-brace-format
msgid "Enter the new name of the subcategory of '{parent_name}'"
msgstr "Geben Sie den neuen Namen der Unterkategorie von „{parent_name}“ ein."

#. Translators: Title of the dialog for renaming a child category.
#: ui/category_tree.py:310
msgid "Rename subcategory"
msgstr "Unterkategorie bearbeiten"

#. Translators: Title of the confirmation for deleting a category
#. and everything it contains.
#: ui/category_tree.py:353
msgid "Delete category"
msgstr "Kategorie löschen"

#. Translators: Status after copying a category; it remains pending
#. until the user selects a destination and presses Ctrl+V.
#: ui/category_tree.py:407
msgid "Copied category. Select a destination and press Ctrl+V."
msgstr "Kategorie kopiert. Wählen Sie ein Ziel aus und drücken Sie Strg+V."

#. Translators: Status after cutting a category; it remains pending
#. until the user selects a destination and presses Ctrl+V.
#: ui/category_tree.py:413
msgid "Cut category. Select a destination and press Ctrl+V."
msgstr "Kategorie ausgeschnitten. Wählen Sie ein Ziel aus und drücken Sie Strg+V."

#. Translators: Explains that a snippet cannot be pasted at the
#. category-tree root and requires a destination category.
#: ui/category_tree.py:430
msgid "A snippet must be pasted into a category."
msgstr "Ein Textbaustein muss in eine Kategorie eingefügt werden."

#. Translators: Title of an informational message explaining that
#. snippets cannot be pasted at the category-tree root.
#: ui/category_tree.py:433
msgid "Paste snippet"
msgstr "Textbaustein einfügen"

#. Translators: Status after a copied or cut category was pasted.
#: ui/category_tree.py:483
msgid "Transfer completed."
msgstr "Übertragung abgeschlossen."

#. Translators: Title of an error caused by a category operation.
#: ui/category_tree.py:509
msgid "Category error"
msgstr "Kategoriefehler"

#. Translators: Confirmation before deleting a category and all its
#. contents. {name} is its name; both displayed counts are exactly 1.
#: ui/category_tree.py:529
#, python-brace-format
msgid "Delete category '{name}', {descendants} subcategory and {snippets} snippet?"
msgstr "Kategorie „{name}“ einschließlich {descendants} Unterkategorie und {snippets} Textbaustein löschen?"

#. Translators: Confirmation before deleting a category and all its
#. contents. {name} is its name; descendants is 1, snippets is not 1.
#: ui/category_tree.py:533
#, python-brace-format
msgid "Delete category '{name}', {descendants} subcategory and {snippets} snippets?"
msgstr "Kategorie „{name}“ einschließlich {descendants} Unterkategorie und {snippets} Textbausteinen löschen?"

#. Translators: Confirmation before deleting a category and all its
#. contents. {name} is its name; descendants is not 1, snippets is 1.
#: ui/category_tree.py:537
#, python-brace-format
msgid "Delete category '{name}', {descendants} subcategories and {snippets} snippet?"
msgstr "Kategorie „{name}“ einschließlich {descendants} Unterkategorien und {snippets} Textbaustein löschen?"

#. Translators: Confirmation before deleting a category and all its
#. contents. {name} is its name; neither displayed count is 1.
#: ui/category_tree.py:541
#, python-brace-format
msgid "Delete category '{name}', {descendants} subcategories and {snippets} snippets?"
msgstr "Kategorie „{name}“ einschließlich {descendants} Unterkategorien und {snippets} Textbausteinen löschen?"

#. Translators: Heading for the tree used to select a category.
#. "&" marks the keyboard mnemonic for the category tree.
#: ui/main_frame.py:111
msgid "&Categories"
msgstr "&Kategorien"

#. Translators: Heading for the list of snippets in the selected
#. category. "&" marks the keyboard mnemonic for the snippet list.
#: ui/main_frame.py:126
msgid "&Snippets"
msgstr "&Textbausteine"

#. Translators: Accessible name for the main window list showing snippets
#. from the selected category.
#: ui/main_frame.py:139
msgid "Snippets in the selected category"
msgstr "Textbausteine in der ausgewählten Kategorie"

#. Translators: Title for a failure to monitor or expand a
#. globally typed snippet hotstring.
#: ui/main_frame.py:199 ui/main_frame.py:368 ui/main_frame.py:489
msgid "Hotstring error"
msgstr "Hotstring-Fehler"

#. Translators: Generic title for a failed main-window operation.
#. Translators: Generic title for a failed snippet operation.
#. Translators: Generic title for a failed snippet-list operation.
#. Translators: Generic title for a failed snippet deletion.
#: ui/main_frame.py:226 ui/main_frame.py:245 ui/main_frame.py:257
#: ui/main_frame.py:558 ui/snippet_list.py:415 ui/snippet_list.py:445
#: ui/snippet_list.py:485
msgid "Error"
msgstr "Fehler"

#. Translators: Error shown when a selected snippet points to a
#. category that was deleted meanwhile.
#: ui/main_frame.py:243
msgid "The category of the selected snippet no longer exists."
msgstr "Die Kategorie des ausgewählten Textbausteins ist nicht mehr vorhanden."

#. Translators: Error shown when the selected snippet was deleted
#. before it could be displayed or inserted.
#: ui/main_frame.py:255
msgid "The selected snippet no longer exists."
msgstr "Der ausgewählte Textbaustein ist nicht mehr vorhanden."

#. Translators: Startup error shown when btText cannot claim
#. its global shortcut. {} is a shortcut such as Ctrl+Alt+T.
#: ui/main_frame.py:277
#, python-brace-format
msgid "The global hotkey {} is already in use and could not be registered."
msgstr "Die globale Tastenkombination {} wird bereits verwendet und konnte nicht registriert werden."

#. Translators: Title of an error registering a global shortcut.
#. Translators: Title of an error changing the global shortcut.
#. Translators: Title of an error restoring a global shortcut.
#: ui/main_frame.py:281 ui/main_frame.py:397 ui/main_frame.py:434
msgid "Hotkey error"
msgstr "Fehler bei der Tastenkombination"

#. Translators: Settings error: the requested global shortcut is
#. occupied, so btText kept the old one. {} is such as Ctrl+Alt+T.
#: ui/main_frame.py:384
#, python-brace-format
msgid "The selected hotkey {} is already in use. The previous hotkey has been restored."
msgstr "Die ausgewählte Tastenkombination {} wird bereits verwendet. Die vorherige Tastenkombination wurde wiederhergestellt."

#. Translators: Settings error: the requested shortcut is occupied
#. and restoring the old one also failed. {} is such as Ctrl+Alt+T.
#: ui/main_frame.py:391
#, python-brace-format
msgid "The selected hotkey {} is already in use and the previous hotkey could not be restored. No global hotkey is active."
msgstr "Die ausgewählte Tastenkombination {} wird bereits verwendet, und die vorherige Tastenkombination konnte nicht wiederhergestellt werden. Es ist keine globale Tastenkombination aktiv."

#. Translators: Error after cancelling settings when btText
#. could not restore the previously active global shortcut.
#: ui/main_frame.py:430
msgid "The previous hotkey could not be restored. No global hotkey is active."
msgstr "Die vorherige Tastenkombination konnte nicht wiederhergestellt werden. Es ist keine globale Tastenkombination aktiv."

#. Translators: Error when no previously active external window is
#. available as the destination for inserting a snippet.
#: ui/main_frame.py:545
msgid "There is no previous window to insert the snippet into."
msgstr "Es gibt kein vorheriges Fenster, in das der Textbaustein eingefügt werden kann."

#. Translators: Title of an error inserting a snippet externally.
#. Translators: Title of an error while pasting copied or cut items.
#: ui/main_frame.py:547 ui/main_frame.py:579 ui/snippet_list.py:352
msgid "Paste error"
msgstr "Fehler beim Einfügen"

#. Translators: Error after inserting a snippet when restoring the
#. user's old clipboard repeatedly failed. {} is a technical error.
#: ui/main_frame.py:615
#, python-brace-format
msgid ""
"The previous clipboard contents could not be restored after multiple attempts. The clipboard may still contain the inserted snippet.\n"
"\n"
"{}"
msgstr ""
"Der vorherige Inhalt der Zwischenablage konnte auch nach mehreren Versuchen nicht wiederhergestellt werden. Die Zwischenablage enthält möglicherweise weiterhin den eingefügten Textbaustein.\n"
"\n"
"{}"

#. Translators: Title of an error restoring the user's clipboard
#. after a snippet was inserted.
#: ui/main_frame.py:621
msgid "Clipboard restore error"
msgstr "Fehler beim Wiederherstellen der Zwischenablage"

#. Translators: Edit-menu command that opens the snippet search
#. dialog. "&" marks the mnemonic; keep F3 after "\t".
#: ui/main_frame.py:634
msgid "&Search...\tF3"
msgstr "&Suchen...\tF3"

#. Translators: Edit-menu command that opens the settings dialog.
#. "&" marks the mnemonic; keep Ctrl+, after "\t".
#: ui/main_frame.py:641
msgid "&Settings...\tCtrl+,"
msgstr "&Einstellungen...\tCtrl+,"

#. Translators: Main-window menu containing search and settings commands.
#. "&" marks the keyboard mnemonic.
#: ui/main_frame.py:645
msgid "&Edit"
msgstr "&Bearbeiten"

#. Translators: Help-menu command that opens application information.
#: ui/main_frame.py:648
msgid "About"
msgstr "Über btText"

#. Translators: Main-window menu containing application information.
#. "&" marks the keyboard mnemonic.
#: ui/main_frame.py:652
