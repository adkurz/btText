#. Translators: Snippet-list menu command that cuts the selected
#. snippet or snippets. Keep Ctrl+X after "\t".
#: ui/snippet_list.py:188
msgid "Cut snippet\tCtrl+X"
msgid_plural "Cut snippets\tCtrl+X"
msgstr[0] "Textbaustein ausschneiden\tCtrl+X"
msgstr[1] "Textbausteine ausschneiden\tCtrl+X"

#. Translators: Snippet-list menu command that deletes the selected
#. snippet or snippets. The final "Delete" is the keyboard key.
#: ui/snippet_list.py:208
msgid "Delete snippet\tDelete"
msgid_plural "Delete snippets\tDelete"
msgstr[0] "Textbaustein löschen\tEntf"
msgstr[1] "Textbausteine löschen\tEntf"

#. Translators: Title of an error copying snippet text to the
#. Windows clipboard.
#: ui/snippet_list.py:260
msgid "Clipboard error"
msgstr "Zwischenablagefehler"

#. Translators: Status after a snippet's text was copied to the Windows
#. clipboard.
#: ui/snippet_list.py:267
msgid "Text copied to clipboard."
msgstr "Text in die Zwischenablage kopiert."

#. Translators: Status after copying snippets; they are not pasted
#. yet. Copies omit globally unique hotstrings. {count} is the
#. number copied, and Ctrl+V is the paste shortcut.
#: ui/snippet_list.py:281
#, python-brace-format
msgid "Copied {count} snippet. Its hotstring will not be included when pasted. Select a category and press Ctrl+V."
msgid_plural "Copied {count} snippets. Their hotstrings will not be included when pasted. Select a category and press Ctrl+V."
msgstr[0] "{count} Textbaustein kopiert. Sein Hotstring wird beim Einfügen nicht übernommen. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."
msgstr[1] "{count} Textbausteine kopiert. Ihre Hotstrings werden beim Einfügen nicht übernommen. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."

#. Translators: Status after cutting snippets; they are not moved yet.
#. {count} is the number cut, and Ctrl+V is the paste shortcut.
#: ui/snippet_list.py:291
#, python-brace-format
msgid "Cut {count} snippet. Select a category and press Ctrl+V."
msgid_plural "Cut {count} snippets. Select a category and press Ctrl+V."
msgstr[0] "{count} Textbaustein ausgeschnitten. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."
msgstr[1] "{count} Textbausteine ausgeschnitten. Wählen Sie eine Kategorie aus und drücken Sie Strg+V."

#. Translators: Explains that the top-level paste command only
#. accepts a copied or cut category, not snippets.
#: ui/snippet_list.py:312
msgid "Only a category can be pasted as a top-level category."
msgstr "Nur eine Kategorie kann auf der obersten Ebene eingefügt werden."

#. Translators: Title of information about pasting a category
#. at the category-tree root.
#: ui/snippet_list.py:315
msgid "Paste as top-level"
msgstr "Auf oberster Ebene einfügen"

#. Translators: Status after a pending copy or cut operation is pasted.
#. {count} includes all transferred categories and snippets.
#: ui/snippet_list.py:367
#, python-brace-format
msgid "Transferred {count} item."
msgid_plural "Transferred {count} items."
msgstr[0] "{count} Element übertragen."
msgstr[1] "{count} Elemente übertragen."

#. Translators: Confirmation before permanently deleting one snippet.
#. {name} is the snippet's name.
#: ui/snippet_list.py:462
#, python-brace-format
msgid "Do you want to delete the snippet '{name}'?"
msgstr "Möchten Sie den Textbaustein „{name}“ löschen?"

#. Translators: Title of the confirmation for deleting one snippet.
#: ui/snippet_list.py:466
msgid "Delete snippet?"
msgstr "Textbaustein löschen?"

#. Translators: Confirmation before permanently deleting several
#. selected snippets. {count} is the number selected.
#: ui/snippet_list.py:471
#, python-brace-format
msgid "Do you want to delete {count} selected snippet?"
msgid_plural "Do you want to delete {count} selected snippets?"
msgstr[0] "Möchten Sie {count} ausgewählten Textbaustein löschen?"
msgstr[1] "Möchten Sie {count} ausgewählte Textbausteine löschen?"

#. Translators: Title of the confirmation for deleting multiple snippets.
#: ui/snippet_list.py:476
msgid "Delete snippets?"
msgstr "Textbausteine löschen?"

# | msgid "Delete snippet?"
#. Translators: Status after selected snippets were permanently deleted.
#. {count} is the number deleted.
#: ui/snippet_list.py:504
#, python-brace-format
msgid "Deleted {count} snippet."
msgid_plural "Deleted {count} snippets."
msgstr[0] "{count} Textbaustein gelöscht."
msgstr[1] "{count} Textbausteine gelöscht."

# | msgid "{app_name} {app_version}"
#. Translators: Notification-area tooltip identifying the running
#. application. Keep the application name and version placeholders.
#: ui/tray_icon.py:28
#, python-brace-format
msgid "{app_name} {app_version}"
msgstr "{app_name} {app_version}"

#. Translators: Notification-area menu command that restores and focuses
#. btText's main window.
#: ui/tray_icon.py:40
msgid "Show snippets"
msgstr "Textbausteine anzeigen"

#. Translators: Notification-area menu command that closes btText.
#: ui/tray_icon.py:43
msgid "Exit"
msgstr "Beenden"

#. Translators: Windows notification after a hotstring expansion.
#. {hotstring} is the typed abbreviation and {snippet} is the name of
#. the inserted snippet; the snippet content is deliberately omitted.
#: ui/tray_icon.py:66
#, python-brace-format
msgid "Hotstring “{hotstring}” expanded to “{snippet}”."
msgstr "Hotstring „{hotstring}“ mit „{snippet}“ erweitert."

#. Translators: Lowest search-ranking weight assigned to a snippet.
#: ui/utils.py:143
msgctxt "snippet weight"
msgid "Low"
msgstr "Niedrig"

#. Translators: Medium search-ranking weight assigned to a snippet.
#: ui/utils.py:145
msgctxt "snippet weight"
msgid "Middle"
msgstr "Mittel"

#. Translators: Highest search-ranking weight assigned to a snippet.
#: ui/utils.py:147
msgctxt "snippet weight"
msgid "High"
msgstr "Hoch"

#. Translators: Validation message shown below an empty required
#. field in a snippet or category editor.
#: ui/validators.py:27
