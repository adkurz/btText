msgid "F3: Search snippets    Enter: Insert selected snippet"
msgstr "F3: Textbausteine suchen    Eingabetaste: Ausgewählten Textbaustein einfügen"

#. Translators: Window title for finding snippets.
#: ui/search_dialog.py:22
msgid "Search snippets"
msgstr "Textbausteine suchen"

#. Translators: Label for the text field used to search snippets.
#. "&" marks the keyboard mnemonic for the adjacent field.
#: ui/search_dialog.py:32
msgid "&Search"
msgstr "&Suchen"

#. Translators: Label for the list of snippets matching the search.
#. "&" marks the keyboard mnemonic for the adjacent result list.
#: ui/search_dialog.py:36
msgid "Search &results"
msgstr "Such&ergebnisse"

#. Translators: Search-results column containing each snippet's name.
#. Translators: Snippet-list column containing each snippet's name.
#: ui/search_dialog.py:42 ui/snippet_list.py:44
msgid "Name"
msgstr "Name"

#. Translators: Search-results column containing the snippet's category.
#: ui/search_dialog.py:44
msgid "Category"
